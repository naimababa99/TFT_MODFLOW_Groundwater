# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# =============================================================================
# Third-party MODFLOW-2005 distribution
# -----------------------------------------------------------------------------
# MF2005.1_12/ is the unmodified USGS MODFLOW-2005 v1.12 release (~78 MB of
# executables, Fortran source, PDFs and test problems). It is redistributable
# software, not part of this study, so it is not vendored here. See the README
# section "MODFLOW-2005 executable" for the download link and expected path.
# =============================================================================
MF2005.1_12/

# =============================================================================
# Trained model weights and archives (regenerated by the training scripts)
# -----------------------------------------------------------------------------
# Every prediction CSV, metrics CSV, run_config.json, interpretation table and
# figure IS tracked, so all reported numbers and plots stay verifiable without
# the ~123 MB of checkpoints.
# =============================================================================
*.pt
*.pth
*.ckpt
*.zip

# =============================================================================
# MODFLOW simulation workspaces and scratch output
# -----------------------------------------------------------------------------
# Written by FloPy on every calibration run and fully regenerated by
# _run_modflow_vf.py. The calibrated parameters (*.joblib) and the prior itself
# (enhanced_predictions.csv / train_only_predictions.csv) are tracked.
# =============================================================================
modflow_workspace/
models/modflow_calibrated/calib_*/
*.hds
*.cbc
*.list
*.lst
*.nam
*.dis
*.bas
*.lpf
*.pcg
*.oc
*.rch
*.wel
*.chd
*.ddn

# =============================================================================
# Run logs and training telemetry
# =============================================================================
logs/
lightning_logs/
*.log

# =============================================================================
# Superseded working copies (kept locally, not part of the released pipeline)
# =============================================================================
data/_pre_leakage_fix_backup/
.dist/

# =============================================================================
# Editor / OS noise
# =============================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.bkp
.$*
